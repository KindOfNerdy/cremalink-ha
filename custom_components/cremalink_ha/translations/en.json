  "options": {
    "step": {
      "init": {
        "title": "Local connection settings",
        "description": "Set the IP address the coffee machine should use to reach this Home Assistant instance. Optionally sign in to the cloud once so the recipe catalogue loads in a single request, like the official app.",
        "data": {
          "advertised_ip": "Advertised IP (optional)",
          "email": "Cloud e-mail (optional)",
          "password": "Cloud password (optional)"
        },
        "data_description": {
          "advertised_ip": "Enter the host's LAN IPv4 address when using Docker bridge networking. The coffee machine must be able to reach this address. Leave blank to auto-detect.",
          "email": "Only used for the one-time sign-in. Without it the catalogue is read from the machine over the LAN, one request per recipe on first use.",
          "password": "Never stored — only the resulting refresh token is kept."
        }
      }
    },
    "error": {
      "invalid_advertised_ip": "Enter a valid IPv4 address.",
      "auth_failed": "Cloud sign-in failed. Check e-mail and password."
